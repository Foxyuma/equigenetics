{
  "name": "Competition",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "discipline": {
      "type": "string",
      "enum": [
        "dressage",
        "show_jumping",
        "cross_country",
        "endurance",
        "reining",
        "barrel_racing",
        "polo",
        "eventing",
        "vaulting",
        "driving",
        "trail",
        "western_pleasure",
        "modele_allures"
      ]
    },
    "level": {
      "type": "string",
      "enum": [
        "novice",
        "intermediate",
        "advanced",
        "elite",
        "olympic"
      ]
    },
    "is_olympic": {
      "type": "boolean",
      "default": false
    },
    "horse_id": {
      "type": "string"
    },
    "horse_name": {
      "type": "string"
    },
    "score": {
      "type": "number"
    },
    "rank": {
      "type": "number"
    },
    "prize": {
      "type": "number"
    },
    "status": {
      "type": "string",
      "enum": [
        "registered",
        "completed"
      ],
      "default": "registered"
    },
    "competition_date": {
      "type": "string",
      "format": "date"
    },
    "disqualified": {
      "type": "boolean",
      "default": false,
      "description": "Vrai si le cheval a \u00e9t\u00e9 disqualifi\u00e9 (contr\u00f4le antidopage positif)"
    },
    "disqualification_reason": {
      "type": "string",
      "description": "Motif de la disqualification"
    },
    "breed": {
      "type": "string",
      "description": "Race du concours (pour les mod\u00e8les et allures)"
    },
    "age_class": {
      "type": "number",
      "description": "Classe d'\u00e2ge (0-4) pour les mod\u00e8les et allures"
    },
    "game_year": {
      "type": "number",
      "description": "Ann\u00e9e de jeu du concours (pour limiter \u00e0 1 par an)"
    }
  },
  "required": [
    "name",
    "discipline",
    "horse_id"
  ]
}