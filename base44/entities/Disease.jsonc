{
  "name": "Disease",
  "type": "object",
  "properties": {
    "disease_name": {
      "type": "string",
      "description": "Nom complet de la maladie"
    },
    "gene": {
      "type": "string",
      "description": "Symbole du g\u00e8ne (ex: HYPP, PSSM, SCID)"
    },
    "dominance": {
      "type": "string",
      "enum": [
        "dominant",
        "recessive"
      ],
      "description": "Type de transmission"
    },
    "affected_breeds": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Races principalement affect\u00e9es"
    },
    "genotypes": {
      "type": "object",
      "description": "Mapping des g\u00e9notypes aux statuts",
      "properties": {
        "clear": {
          "type": "string",
          "example": "N/N"
        },
        "carrier": {
          "type": "string",
          "example": "N/H"
        },
        "affected": {
          "type": "string",
          "example": "H/H"
        }
      }
    },
    "lethal_homozygous": {
      "type": "boolean",
      "description": "Homozygote double = l\u00e9tal (mort-n\u00e9)"
    },
    "lethal_age": {
      "type": "number",
      "description": "\u00c2ge auquel le poulain meurt (en ann\u00e9es, si applicable)"
    },
    "effects": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Effets in-game (baisse endurance, paralysie, etc)"
    },
    "test_available": {
      "type": "boolean",
      "default": false,
      "description": "Test g\u00e9n\u00e9tique disponible"
    },
    "severity": {
      "type": "string",
      "enum": [
        "mild",
        "moderate",
        "severe",
        "lethal"
      ],
      "description": "S\u00e9v\u00e9rit\u00e9 g\u00e9n\u00e9rale"
    }
  },
  "required": [
    "disease_name",
    "gene",
    "dominance"
  ]
}