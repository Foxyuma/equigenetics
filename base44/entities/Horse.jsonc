{
  "name": "Horse",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Horse name"
    },
    "breed": {
      "type": "string",
      "description": "Breed of the horse"
    },
    "sex": {
      "type": "string",
      "enum": [
        "male",
        "female"
      ]
    },
    "age": {
      "type": "number",
      "description": "Age in years"
    },
    "image_url": {
      "type": "string",
      "description": "Current horse image URL"
    },
    "foal_image_url": {
      "type": "string",
      "description": "Image g\u00e9n\u00e9r\u00e9e \u00e0 la naissance (poulain)"
    },
    "adult_image_url": {
      "type": "string",
      "description": "Image g\u00e9n\u00e9r\u00e9e \u00e0 l'\u00e2ge adulte (\u22653 ans)"
    },
    "markings_description": {
      "type": "string",
      "description": "Description textuelle des marquages/couleurs"
    },
    "father_id": {
      "type": "string",
      "description": "ID of father horse"
    },
    "mother_id": {
      "type": "string",
      "description": "ID of mother horse"
    },
    "coat_color": {
      "type": "string",
      "description": "Visible coat color"
    },
    "owner_email": {
      "type": "string",
      "description": "Email du propri\u00e9taire actuel (peut diff\u00e9rer du cr\u00e9ateur apr\u00e8s un achat)"
    },
    "studbook_registered": {
      "type": "boolean",
      "default": false,
      "description": "Inscrit au studbook (true) ou OC (false)"
    },
    "studbook_registration_date": {
      "type": "string",
      "format": "date",
      "description": "Date de demande/inscription au studbook"
    },
    "studbook_request_status": {
      "type": "string",
      "enum": [
        "none",
        "pending",
        "approved",
        "rejected"
      ],
      "default": "none",
      "description": "Statut de la demande de studbook"
    },
    "studbook_request_type": {
      "type": "string",
      "enum": [
        "studbook",
        "oc"
      ],
      "description": "Type de demande (plein registre ou OC)"
    },
    "studbook_rejection_reasons": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "Raisons du refus de studbook"
    },
    "genotype": {
      "type": "object",
      "description": "Full genetic profile",
      "properties": {
        "extension": {
          "type": "string"
        },
        "agouti": {
          "type": "string"
        },
        "cream": {
          "type": "string"
        },
        "grey": {
          "type": "string"
        },
        "tobiano": {
          "type": "string"
        },
        "roan": {
          "type": "string"
        },
        "dun": {
          "type": "string"
        },
        "champagne": {
          "type": "string"
        },
        "silver": {
          "type": "string"
        }
      }
    },
    "stats": {
      "type": "object",
      "description": "Ability stats 0-100",
      "properties": {
        "speed": {
          "type": "number"
        },
        "endurance": {
          "type": "number"
        },
        "agility": {
          "type": "number"
        },
        "strength": {
          "type": "number"
        },
        "temperament": {
          "type": "number"
        },
        "jumping": {
          "type": "number"
        },
        "dressage": {
          "type": "number"
        }
      }
    },
    "genetic_potential": {
      "type": "object",
      "description": "Plafond g\u00e9n\u00e9tique individuel par stat (0-100) \u2014 h\u00e9rit\u00e9 et non-modifiable",
      "properties": {
        "speed": {
          "type": "number"
        },
        "endurance": {
          "type": "number"
        },
        "agility": {
          "type": "number"
        },
        "strength": {
          "type": "number"
        },
        "temperament": {
          "type": "number"
        },
        "jumping": {
          "type": "number"
        },
        "dressage": {
          "type": "number"
        }
      }
    },
    "mental_traits": {
      "type": "array",
      "description": "Traits mentaux du cheval",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "morphology": {
      "type": "array",
      "description": "Traits morphologiques cach\u00e9s",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "health_genes": {
      "type": "array",
      "description": "Carried disease genes",
      "items": {
        "type": "object",
        "properties": {
          "disease": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "carrier",
              "affected",
              "clear"
            ]
          }
        }
      }
    },
    "last_age_update_month": {
      "type": "number",
      "description": "Dernier mois de jeu o\u00f9 l'\u00e2ge a \u00e9t\u00e9 mis \u00e0 jour (permet le vieillissement automatis\u00e9)"
    },
    "energy": {
      "type": "number",
      "description": "\u00c9nergie physique 0-100",
      "default": 100
    },
    "mental_energy": {
      "type": "number",
      "description": "\u00c9nergie mentale 0-100",
      "default": 100
    },
    "character": {
      "type": "string",
      "enum": [
        "energique",
        "anxieux",
        "intelligent",
        "paresseux",
        "courageux",
        "docile"
      ],
      "description": "Caract\u00e8re du cheval"
    },
    "competition_wins": {
      "type": "number",
      "default": 0
    },
    "is_for_sale": {
      "type": "boolean",
      "default": false
    },
    "price": {
      "type": "number",
      "default": 0
    },
    "estimated_value": {
      "type": "number",
      "default": 0
    },
    "breeding_approval_status": {
      "type": "string",
      "enum": [
        "not_evaluated",
        "rejected",
        "approved_for_breeding",
        "approved_for_sport_breeding",
        "elite_approved"
      ],
      "default": "not_evaluated"
    },
    "breeding_approval_breed": {
      "type": "string"
    },
    "breeding_approval_date": {
      "type": "string",
      "format": "date"
    },
    "foal_training_completed": {
      "type": "object",
      "description": "Suivi des comp\u00e9tences poulain",
      "properties": {
        "manipulation": {
          "type": "number",
          "default": 0
        },
        "desensibilisation": {
          "type": "number",
          "default": 0
        },
        "embarquement": {
          "type": "number",
          "default": 0
        }
      },
      "default": {}
    },
    "doping_risk_until": {
      "type": "string",
      "format": "date-time",
      "description": "Date jusqu'\u00e0 laquelle le cheval est sous substances d\u00e9tectables (risque de contr\u00f4le positif)"
    }
  },
  "required": [
    "name",
    "breed",
    "sex"
  ]
}