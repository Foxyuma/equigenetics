{
  "name": "Inventory",
  "type": "object",
  "properties": {
    "item_id": {
      "type": "string",
      "description": "Reference to Item"
    },
    "item_name": {
      "type": "string"
    },
    "item_type": {
      "type": "string"
    },
    "item_icon": {
      "type": "string"
    },
    "quantity": {
      "type": "number",
      "default": 1
    },
    "effect": {
      "type": "object",
      "description": "Cached item effect data"
    }
  },
  "required": [
    "item_id",
    "quantity"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "user"
      }
    },
    "read": {
      "created_by": "{{user.email}}"
    },
    "update": {
      "created_by": "{{user.email}}"
    },
    "delete": {
      "created_by": "{{user.email}}"
    }
  }
}