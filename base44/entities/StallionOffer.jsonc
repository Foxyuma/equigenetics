    },
    "reserved_for_email": {
      "type": "string",
      "description": "Email du joueur r\u00e9serv\u00e9 (si is_open = false)"
    },
    "reserved_for_name": {
      "type": "string",
      "description": "Nom du joueur r\u00e9serv\u00e9"
    },
    "breeding_approval_status": {
      "type": "string"
    },
