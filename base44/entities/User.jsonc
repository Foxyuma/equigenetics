{
  "name": "User",
  "type": "object",
  "properties": {
    "role": {
      "type": "string",
      "enum": [
        "admin",
        "user"
      ],
      "default": "user"
    },
    "genesis_balance": {
      "type": "number",
      "default": 300000,
      "description": "Monnaie principale gagn\u00e9e en jeu"
    },
    "credits_balance": {
      "type": "number",
      "default": 10,
      "description": "Monnaie premium achet\u00e9e avec de l'argent r\u00e9el"
    }
  }
}