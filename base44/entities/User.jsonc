{
  "name": "User",
  "type": "object",
  "properties": {
    "role": {
      "type": "string",
      "enum": [
        "admin",
        "user"
      ],
      "default": "user"
    },
    "genesis_balance": {
      "type": "number",
      "default": 300000,
      "description": "Monnaie principale gagn\u00e9e en jeu"
    },
    "credits_balance": {
      "type": "number",
      "default": 10,
      "description": "Monnaie premium achet\u00e9e avec de l'argent r\u00e9el"
    },
    "breeding_reputation": {
      "type": "number",
      "default": 0,
      "description": "Points de r\u00e9putation d'\u00e9levage cumul\u00e9s"
    },
    "affixes": {
      "type": "array",
      "description": "Affixes d'\u00e9levage du joueur",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "position": {
            "type": "string",
            "enum": [
              "prefix",
              "suffix"
            ],
            "description": "Avant ou apr\u00e8s le nom du cheval"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "default": []
    },
    "last_bulk_checkup_date": {
      "type": "string",
      "format": "date",
      "description": "Date du dernier contr\u00f4le v\u00e9t\u00e9rinaire group\u00e9 (1x/jour)"
    }
  },
  "required": []
}